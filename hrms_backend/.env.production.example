# Production env template for api-hrms.jaikalki.com
# Copy to .env on the production server and fill in real secrets.

APP_NAME=Jaikalki HRMS
DEBUG=false
ENVIRONMENT=production
API_V1_PREFIX=/api/v1
API_ADMIN_PREFIX=/api/admin

COMPANY_NAME=Jaikalki Technology Pvt Ltd
COMPANY_ADDRESS=Sh N B1/A Ground Floor, Mahavir Nagar, Deepak Hospital, Mira Road, Thane-401107 Maharashtra
EMPLOYEE_CODE_PREFIX=JKT

# Database — replace credentials with the production values.
DATABASE_URL=mysql+aiomysql://USER:PASSWORD@DB_HOST:3306/db_hrms_jaikalki?charset=utf8mb4
DATABASE_URL_SYNC=mysql+pymysql://USER:PASSWORD@DB_HOST:3306/db_hrms_jaikalki?charset=utf8mb4
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=40

REDIS_URL=redis://REDIS_HOST:6379/0

# CRITICAL: rotate this to a long random string in production.
JWT_SECRET_KEY=REPLACE_ME_WITH_A_64_CHAR_RANDOM_SECRET
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRE_DAYS=30

# CORS — only the real frontend origins should be listed here.
CORS_ORIGINS=["https://portal.jaikalki.com","https://api-hrms.jaikalki.com"]

# Public base URL of this API.
PUBLIC_BASE_URL=https://api-hrms.jaikalki.com

# File storage — defaults to a local mounted directory on the host.
STORAGE_BACKEND=local
LOCAL_STORAGE_PATH=/app/uploads
LOCAL_STORAGE_URL_PREFIX=/uploads
# Mount this host path into the api container (see docker-compose).
HRMS_UPLOADS_PATH=/srv/jaikalki/uploads

# Optional fallback to S3 — set STORAGE_BACKEND=s3 to enable.
S3_ENDPOINT=https://s3.ap-south-1.amazonaws.com
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET=jaikalki-hrms
S3_REGION=ap-south-1
